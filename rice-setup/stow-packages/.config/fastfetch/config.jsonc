{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "auto",
    "color": {"1": "blue", "2": "magenta"}
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "magenta"
    }
  },
  "modules": [
    "title",
    "separator",
    {
      "type": "os",
      "key": "OS   ",
      "keyColor": "red"
    },
    {
      "type": "host",
      "key": "Host ",
      "keyColor": "green"
    },
    {
      "type": "kernel",
      "key": "Kernel",
      "keyColor": "yellow"
    },
    {
      "type": "uptime",
      "key": "Uptime",
      "keyColor": "blue"
    },
    {
      "type": "packages",
      "key": "Pkgs ",
      "keyColor": "magenta"
    },
    {
      "type": "shell",
      "key": "Shell",
      "keyColor": "cyan"
    },
    {
      "type": "wm",
      "key": "WM   ",
      "keyColor": "red"
    },
    {
      "type": "theme",
      "key": "Theme",
      "keyColor": "green"
    },
    {
      "type": "icons",
      "key": "Icons",
      "keyColor": "yellow"
    },
    {
      "type": "terminal",
      "key": "Term ",
      "keyColor": "blue"
    },
    {
      "type": "cpu",
      "key": "CPU  ",
      "keyColor": "magenta"
    },
    {
      "type": "gpu",
      "key": "GPU  ",
      "keyColor": "cyan"
    },
    {
      "type": "memory",
      "key": "Mem  ",
      "keyColor": "red"
    },
    "break",
    "colors"
  ]
}